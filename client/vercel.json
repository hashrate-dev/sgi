{
  "installCommand": "cd .. && npm install",
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api?path=:path*" },
    { "source": "/((?!api).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/index.js": { "maxDuration": 60 },
    "api/paper/cron-tick.js": { "maxDuration": 60 }
  },
  "crons": [
    {
      "path": "/api/paper/cron-tick",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/crypto-noticias/cron-ingest",
      "schedule": "*/2 * * * *"
    }
  ]
}
